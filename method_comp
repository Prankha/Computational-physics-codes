import matplotlib.pyplot as plt
import numpy as np
k=-1
x=1
u=0
dt= 0.01
n=1000
t=0
pos_e=[]
pos_me=[]
pos_rk2=[]
vel_e=[]
vel_me=[]
vel_rk2=[]
time=[]
for i in range(n):
    u_p = u + k*x*dt
    u_2 = (u_p + u)/2
    v_me = u + dt/2*(u+u_2)
    x_p = x + u_p*dt
    x_2= (x_p+x)/2
    p_me = x + dt/2 * (x+x_2)
    t+=dt
    vel_e.append(u_p)
    pos_e.append(x)
    vel_me.append(v_me)
    pos_me.append(p_me)
    time.append(t)
plt.plot(time,pos_me)
plt.plot(time,vel_me)
plt.show()
